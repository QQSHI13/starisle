{
  "name": "starisle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "seed": "node scripts/fetch-seed.mjs && node scripts/hash-passwords.mjs",
    "db:reset": "wrangler d1 execute starisle --local --file=src/db/schema.sql && wrangler d1 execute starisle --local --file=src/db/seed.sql",
    "demo": "npm run db:reset && npm run build && wrangler dev",
    "worker:dev": "wrangler dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "wrangler": "^4.134.0"
  }
}
