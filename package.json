{
  "name": "starisle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "bunx vite build",
    "check": "bunx tsc --noEmit",
    "start": "bun src/server/node.ts",
    "demo": "rm -rf data dist && bun run seed && bun run build && (bun src/server/node.ts & sleep 4 && bun scripts/seed-demo.mjs && wait)",
    "seed": "bun scripts/fetch-seed.mjs && bun scripts/hash-passwords.mjs",
    "deploy": "bunx wrangler deploy",
    "seed:demo": "bun scripts/seed-demo.mjs"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.134.0"
  },
  "packageManager": "bun@1.4.2"
}